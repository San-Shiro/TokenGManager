<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_settings"
    app:startDestination="@id/settingsFragment">

    <!-- Start -->

    <fragment
        android:id="@+id/settingsFragment"
        android:name="org.tokeng.gms.ui.SettingsFragment"
        android:label="@string/gms_settings_name">
        <action
            android:id="@+id/openCheckinSettings"
            app:destination="@id/checkinFragment" />
    </fragment>

    <!-- Device registration -->

    <fragment
        android:id="@+id/checkinFragment"
        android:name="org.tokeng.gms.ui.DeviceRegistrationFragment"
        android:label="@string/service_name_checkin"
        tools:layout="@layout/device_registration_fragment" />

    <!-- Unified Accounts & Token Manager -->

    <fragment
        android:id="@+id/accountManagerFragment"
        android:name="org.tokeng.gms.ui.UnifiedDashboardFragment"
        android:label="@string/pref_account_title" />

    <!-- Token Generator alias to UnifiedDashboardFragment -->

    <fragment
        android:id="@+id/tokenGeneratorFragment"
        android:name="org.tokeng.gms.ui.UnifiedDashboardFragment"
        android:label="@string/pref_account_title" />

</navigation>
