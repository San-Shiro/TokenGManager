<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="@string/gms_app_name"
            android:src="@mipmap/ic_launcher" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="TokenG"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Secure Token Vault &amp; Multi-Device Sync"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Network Status Badge -->
        <TextView
            android:id="@+id/tv_network_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="● Connecting to TokenG Cloud..."
            android:textColor="#38BDF8"
            android:textSize="12sp" />

        <!-- Auth Card -->
        <LinearLayout
            android:id="@+id/layout_auth_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#131B2E"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Mode Switcher (Sign In vs Register) -->
            <LinearLayout
                android:id="@+id/layout_tabs"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#0F172A"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tab_sign_in"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Sign In"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tab_register"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Create Account"
                    android:textColor="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Email Input -->
            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="#0F172A"
                android:fontFamily="sans-serif"
                android:hint="Email (Gmail)"
                android:inputType="textEmailAddress"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp" />

            <!-- Password Input -->
            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="#0F172A"
                android:fontFamily="sans-serif"
                android:hint="Master Password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp" />

            <!-- Confirm Password Input (Register only) -->
            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="#0F172A"
                android:fontFamily="sans-serif"
                android:hint="Confirm Master Password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Primary Action Button -->
            <Button
                android:id="@+id/btn_primary_auth"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#2563EB"
                android:fontFamily="sans-serif-medium"
                android:text="Sign In to Cloud"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_auth"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="#38BDF8"
                android:visibility="gone" />

            <!-- Error Message -->
            <TextView
                android:id="@+id/tv_auth_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Local Mode Fallback Section (Displayed when Server is Down) -->
        <LinearLayout
            android:id="@+id/layout_local_mode_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="────────  OR  ────────"
                android:textColor="#475569"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_enter_local_mode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Enter Local Mode"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                app:strokeColor="#0284C7"
                app:strokeWidth="1.5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Server is temporarily down. Manage tokens locally on this device."
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Offline Unlock Section (Displayed when Completely Offline) -->
        <LinearLayout
            android:id="@+id/layout_offline_unlock_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#131B2E"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Unlock Local Vault"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Device is offline. Enter your unlocking password to access your local tokens."
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_offline_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="#0F172A"
                android:hint="Vault Password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_unlock_offline"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#0284C7"
                android:text="Unlock Vault"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Offline Initial Setup Blocked Message -->
        <LinearLayout
            android:id="@+id/layout_offline_blocked_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No Internet Connection\nAn internet connection is required for initial cloud registration."
                android:textColor="#EF4444"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_retry_connectivity"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:text="Retry Connection"
                android:textAllCaps="false"
                android:textColor="#38BDF8"
                app:strokeColor="#0284C7" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
