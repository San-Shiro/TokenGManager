<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="?attr/listPreferredItemPaddingStart"
    android:layout_marginEnd="?attr/listPreferredItemPaddingEnd"
    android:layout_marginBottom="12dp"
    android:background="@drawable/preference_background_single"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Icon, Title, Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/theme_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_theme"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/theme_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?android:attr/textColorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/theme_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:textColorSecondary"
                tools:text="System default" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compact Segmented Toggle Panel -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/theme_toggle_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_theme_system"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="System"
            android:textSize="12sp"
            app:icon="@drawable/ic_system_mode"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_theme_light"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Light"
            android:textSize="12sp"
            app:icon="@drawable/ic_light_mode"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_theme_dark"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="40dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Dark"
            android:textSize="12sp"
            app:icon="@drawable/ic_dark_mode"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="16dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
